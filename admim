<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="robots" content="noindex,nofollow">
<title>Painel Admin — Larissa Amorim Lash Academy</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;1,500&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<style>
:root{
  --bg:#110d07;--bg2:#18120a;--card:#1f1810;--card2:#271e13;--line:#3a2e1b;
  --ink:#F6EDD6;--mut:#B8A57E;--dim:#7d6d4f;
  --gold:#E3B640;--gold2:#F5D867;--gold3:#C8961E;
  --grad:linear-gradient(135deg,#B8861C 0%,#E3B640 30%,#FBE27A 52%,#E0AE35 72%,#C28E1E 100%);
  --ok:#7FC99A;--warn:#E9C46A;--bad:#E07A6A;--info:#8EB8E6;
  box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);
}
*{margin:0;box-sizing:border-box}
html,body{height:100%}
body{background:radial-gradient(120% 60% at 50% -10%,#2a1f0c 0%,transparent 60%) no-repeat,var(--bg);background-attachment:fixed;color:var(--ink);font:300 15px/1.55 Poppins,system-ui,sans-serif;-webkit-font-smoothing:antialiased;}
h1,h2,h3{font-family:'Playfair Display',Georgia,serif;font-weight:600}
button,input,select,textarea{font:inherit;color:inherit}
button{cursor:pointer}
[hidden]{display:none!important}
.gold-text{background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}

/* LOGIN */
#login{min-height:100vh;display:grid;place-items:center;padding:24px}
.login-card{width:min(100%,380px);background:linear-gradient(180deg,var(--card2),var(--card));border:1px solid var(--line);border-radius:22px;padding:34px 28px;box-shadow:0 30px 80px -30px #000;text-align:center}
.login-card img{width:210px;max-width:80%;height:auto;margin:0 auto 18px;display:block}
.login-card p{color:var(--mut);font-size:.88rem;margin-bottom:22px}
.field{display:flex;flex-direction:column;gap:6px;text-align:left;margin-bottom:14px;font-size:.8rem;color:var(--mut)}
.field input,.inp{background:#0f0b06;border:1px solid var(--line);border-radius:10px;padding:12px 14px;font-size:.95rem;color:var(--ink);outline:none;transition:border-color .2s}
.field input:focus,.inp:focus{border-color:var(--gold)}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:0;border-radius:10px;padding:11px 18px;font-weight:500;font-size:.9rem;background:var(--grad);background-size:200% 100%;color:#2A1C04;transition:background-position .4s,transform .1s}
.btn:hover{background-position:100% 0}.btn:active{transform:scale(.98)}
.btn.ghost{background:transparent;color:var(--ink);border:1px solid var(--line)}
.btn.ghost:hover{border-color:var(--gold)}
.btn.sm{padding:7px 12px;font-size:.8rem;border-radius:8px}
.btn.danger{background:transparent;color:var(--bad);border:1px solid #5a2c25}
.login-card .btn{width:100%;padding:13px}
.err{color:var(--bad);font-size:.85rem;min-height:1.3em;margin-top:10px}

/* APP */
.top{position:sticky;top:0;z-index:20;display:flex;align-items:center;gap:14px;flex-wrap:wrap;padding:12px 22px;background:rgba(17,13,7,.82);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
.top img{height:40px;width:auto}
.top .title{font-family:'Playfair Display',serif;font-size:1.05rem;line-height:1.1}
.top .title small{display:block;font-family:Poppins;font-size:.7rem;color:var(--mut);letter-spacing:.14em;text-transform:uppercase}
.live{display:inline-flex;align-items:center;gap:6px;font-size:.72rem;color:var(--mut);padding:4px 10px;border:1px solid var(--line);border-radius:999px}
.live i{width:7px;height:7px;border-radius:50%;background:var(--dim)}
.live.on i{background:var(--ok);box-shadow:0 0 0 0 rgba(127,201,154,.6);animation:pulse 2s infinite}
@keyframes pulse{70%{box-shadow:0 0 0 8px rgba(127,201,154,0)}100%{box-shadow:0 0 0 0 rgba(127,201,154,0)}}
.top .sp{flex:1}
.filters{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.seg{display:inline-flex;padding:3px;border:1px solid var(--line);border-radius:10px;background:#0f0b06}
.seg button{border:0;background:transparent;padding:6px 11px;border-radius:7px;font-size:.8rem;color:var(--mut)}
.seg button.on{background:var(--grad);color:#2A1C04;font-weight:500}
.inp.sm{padding:6px 9px;font-size:.8rem;border-radius:8px}
select.inp{appearance:none;padding-right:26px;background-image:linear-gradient(45deg,transparent 50%,var(--mut) 50%),linear-gradient(135deg,var(--mut) 50%,transparent 50%);background-position:calc(100% - 13px) 50%,calc(100% - 8px) 50%;background-size:5px 5px;background-repeat:no-repeat}

.tabs{display:flex;gap:4px;overflow-x:auto;padding:14px 22px 0;scrollbar-width:none}
.tabs::-webkit-scrollbar{display:none}
.tabs button{flex:0 0 auto;border:0;background:transparent;padding:10px 16px;border-radius:10px 10px 0 0;color:var(--mut);font-size:.9rem;border-bottom:2px solid transparent}
.tabs button.on{color:var(--ink);border-bottom-color:var(--gold);background:linear-gradient(180deg,transparent,rgba(227,182,64,.08))}
.tabs .count{display:inline-block;min-width:20px;padding:0 6px;margin-left:6px;border-radius:999px;background:var(--card2);font-size:.72rem;color:var(--gold2)}
main{padding:22px;max-width:1320px;margin:0 auto}
.panel{display:none}.panel.on{display:block;animation:fade .3s ease}
@keyframes fade{from{opacity:0;transform:translateY(6px)}}

.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:14px;margin-bottom:18px}
.kpi{background:linear-gradient(180deg,var(--card2),var(--card));border:1px solid var(--line);border-radius:16px;padding:16px 18px;position:relative;overflow:hidden}
.kpi small{color:var(--mut);font-size:.74rem;letter-spacing:.08em;text-transform:uppercase}
.kpi b{display:block;font-family:'Playfair Display',serif;font-size:1.75rem;font-weight:600;margin-top:4px;line-height:1.15}
.kpi span{color:var(--dim);font-size:.78rem}
.kpi.hero{border-color:#6b5320;background:radial-gradient(120% 90% at 100% 0,rgba(245,216,103,.16),transparent 60%),linear-gradient(180deg,var(--card2),var(--card))}
.kpi.hero{grid-column:span 2}.kpi.hero b{background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent;font-size:2.3rem;white-space:nowrap}
@media(max-width:420px){.kpi.hero{grid-column:span 1}}

.grid2{display:grid;grid-template-columns:1.6fr 1fr;gap:14px;margin-bottom:14px}
@media(max-width:900px){.grid2{grid-template-columns:1fr}}
.box{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:18px;min-width:0}
.box h3{font-size:1.05rem;margin-bottom:12px;display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap}
.box h3 small{font-family:Poppins;font-weight:300;font-size:.78rem;color:var(--mut)}
.chart{position:relative;height:280px}

.tw{overflow-x:auto;border:1px solid var(--line);border-radius:14px;background:var(--card)}
table{width:100%;border-collapse:collapse;font-size:.86rem;min-width:720px}
th{position:sticky;top:0;background:var(--card2);color:var(--mut);font-weight:500;text-align:left;padding:11px 12px;font-size:.74rem;letter-spacing:.06em;text-transform:uppercase;white-space:nowrap;border-bottom:1px solid var(--line)}
td{padding:10px 12px;border-bottom:1px solid #2a2114;vertical-align:middle}
tr:last-child td{border-bottom:0}
tbody tr:hover{background:rgba(227,182,64,.04)}
tr.new{animation:flash 2.5s ease}
@keyframes flash{0%,30%{background:rgba(245,216,103,.22)}}
td.num,th.num{text-align:right;white-space:nowrap}
.money{font-variant-numeric:tabular-nums;white-space:nowrap}
.tfoot td{background:var(--card2);font-weight:500}
.cli b{font-weight:500}.cli small{display:block;color:var(--dim);font-size:.75rem}
.wa{display:inline-flex;align-items:center;gap:6px;color:#8fe0a8;text-decoration:none;font-size:.82rem;white-space:nowrap}
.wa svg{width:15px;height:15px;fill:currentColor}
.pill{display:inline-block;padding:3px 10px;border-radius:999px;font-size:.74rem;border:1px solid var(--line);white-space:nowrap}
.st{border-radius:8px;padding:5px 8px;font-size:.78rem;background:#0f0b06;border:1px solid var(--line)}
.st[data-s=pendente]{color:var(--warn);border-color:#5b4a1d}
.st[data-s=confirmado]{color:var(--info);border-color:#2c4460}
.st[data-s=concluido]{color:var(--ok);border-color:#2b5237}
.st[data-s=cancelado],.st[data-s=faltou]{color:var(--bad);border-color:#5a2c25}
.price-in{width:92px;text-align:right;padding:5px 8px;border-radius:8px;background:#0f0b06;border:1px solid var(--line)}
.price-in.missing{border-color:var(--bad)}
.note-in{width:100%;min-width:150px;padding:5px 8px;border-radius:8px;background:#0f0b06;border:1px solid transparent;color:var(--mut);font-size:.8rem}
.note-in:focus{border-color:var(--gold);color:var(--ink);outline:none}
.toolbar{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:12px}
.toolbar .inp{min-width:200px}
.empty{padding:40px;text-align:center;color:var(--dim)}
.rank{display:flex;flex-direction:column;gap:10px}
.rank-row{display:grid;grid-template-columns:26px 1fr auto;gap:10px;align-items:center}
.rank-row .n{font-family:'Playfair Display',serif;color:var(--gold2);font-size:1.05rem;text-align:center}
.rank-row .bar{height:6px;border-radius:6px;background:#2a2114;margin-top:5px;overflow:hidden}
.rank-row .bar i{display:block;height:100%;background:var(--grad)}
.rank-row small{color:var(--dim)}
.upc{display:flex;flex-direction:column;gap:8px}
.upc div{display:flex;justify-content:space-between;gap:10px;padding:9px 12px;border-radius:10px;background:#0f0b06;border:1px solid #2a2114;font-size:.85rem}
.upc em{font-style:normal;color:var(--gold2);white-space:nowrap}
.warnbox{border:1px solid #5a2c25;background:rgba(224,122,106,.07);border-radius:12px;padding:12px 14px;margin-bottom:14px;font-size:.86rem;color:#f0c2b9}
.warnbox b{color:var(--bad)}
.toast{position:fixed;right:18px;bottom:calc(18px + env(safe-area-inset-bottom,0px));z-index:50;display:flex;flex-direction:column;gap:8px}
.toast div{background:var(--card2);border:1px solid #6b5320;border-left:4px solid var(--gold);padding:12px 16px;border-radius:12px;box-shadow:0 16px 40px -10px #000;font-size:.88rem;max-width:340px;animation:fade .3s}
@media(max-width:640px){main{padding:14px}.top{padding:10px 14px}.tabs{padding:10px 14px 0}.kpi b{font-size:1.4rem}.kpi.hero b{font-size:1.7rem}}
</style>
</head>
<body>

<!-- LOGIN -->
<section id="login">
  <form class="login-card" id="loginForm">
    <img src="data:image/webp;base64," alt="Larissa Amorim Lash Academy">
    <p>Área restrita · Painel administrativo</p>
    <label class="field">E-mail<input type="email" name="email" required autocomplete="username"></label>
    <label class="field">Senha<input type="password" name="password" required autocomplete="current-password"></label>
    <button class="btn" type="submit">Entrar</button>
    <div class="err" id="loginErr"></div>
  </form>
</section>

<!-- APP -->
<div id="app" hidden>
  <header class="top">
    <img src="data:image/webp;base64," alt="">
    <div class="title">Painel Admin<small>Agendamentos · CRM · Vendas</small></div>
    <span class="live" id="live"><i></i><span>Ao vivo</span></span>
    <div class="sp"></div>
    <div class="filters">
      <div class="seg" id="period">
        <button data-p="today">Hoje</button><button data-p="7">7 dias</button><button data-p="30" class="on">30 dias</button><button data-p="month">Mês</button><button data-p="all">Tudo</button><button data-p="custom">Período</button>
      </div>
      <span id="customRange" hidden><input type="date" class="inp sm" id="dFrom"> – <input type="date" class="inp sm" id="dTo"></span>
      <select class="inp sm" id="basis" title="Qual data usar">
        <option value="pedido">Data do pedido</option>
        <option value="atend">Data do atendimento</option>
      </select>
      <button class="btn ghost sm" id="exportBtn">⬇ CSV</button>
      <button class="btn ghost sm" id="logout">Sair</button>
    </div>
  </header>

  <nav class="tabs" id="tabs">
    <button data-t="overview" class="on">Visão geral</button>
    <button data-t="orders">Pedidos · CRM<span class="count" id="cOrders">0</span></button>
    <button data-t="clients">Clientes<span class="count" id="cClients">0</span></button>
    <button data-t="daily">Vendas por dia</button>
    <button data-t="models">Modelos & preços</button>
  </nav>

  <main>
    <div id="missingWarn"></div>

    <!-- VISÃO GERAL -->
    <section class="panel on" id="p-overview">
      <div class="kpis" id="kpis"></div>
      <div class="grid2">
        <div class="box"><h3>Vendas por dia <small id="chartSub"></small></h3><div class="chart"><canvas id="chDaily"></canvas></div></div>
        <div class="box"><h3>Modelos mais vendidos</h3><div class="rank" id="rankTop"></div></div>
      </div>
      <div class="grid2">
        <div class="box"><h3>Faturamento por modelo</h3><div class="chart"><canvas id="chModels"></canvas></div></div>
        <div class="box"><h3>Próximos atendimentos</h3><div class="upc" id="upcoming"></div></div>
      </div>
    </section>

    <!-- PEDIDOS / CRM -->
    <section class="panel" id="p-orders">
      <div class="toolbar">
        <input class="inp sm" id="q" placeholder="Buscar nome ou telefone…">
        <select class="inp sm" id="fStatus"><option value="">Todos os status</option></select>
        <select class="inp sm" id="fModel"><option value="">Todos os modelos</option></select>
      </div>
      <div class="tw"><table>
        <thead><tr><th>Pedido em</th><th>Atendimento</th><th>Cliente</th><th>WhatsApp</th><th>Modelo</th><th class="num">Valor</th><th>Status</th><th>Anotações</th><th></th></tr></thead>
        <tbody id="ordersBody"></tbody>
      </table></div>
    </section>

    <!-- CLIENTES -->
    <section class="panel" id="p-clients">
      <div class="toolbar"><input class="inp sm" id="qc" placeholder="Buscar cliente…"></div>
      <div class="tw"><table>
        <thead><tr><th>Cliente</th><th>WhatsApp</th><th class="num">Pedidos</th><th class="num">Total gasto</th><th>Modelo favorito</th><th>Último atendimento</th><th>Primeiro pedido</th></tr></thead>
        <tbody id="clientsBody"></tbody>
      </table></div>
    </section>

    <!-- VENDAS POR DIA -->
    <section class="panel" id="p-daily">
      <div class="box" style="margin-bottom:14px"><h3>Faturamento diário <small id="dailySub"></small></h3><div class="chart"><canvas id="chDaily2"></canvas></div></div>
      <div class="tw"><table>
        <thead id="dailyHead"></thead>
        <tbody id="dailyBody"></tbody>
      </table></div>
    </section>

    <!-- MODELOS & PREÇOS -->
    <section class="panel" id="p-models">
      <div class="grid2">
        <div class="box">
          <h3>Ranking de modelos <small>no período</small></h3>
          <div class="tw" style="border:0"><table style="min-width:520px">
            <thead><tr><th>#</th><th>Modelo</th><th class="num">Saídas</th><th class="num">%</th><th class="num">Faturamento</th><th class="num">Ticket</th></tr></thead>
            <tbody id="modelsBody"></tbody>
          </table></div>
        </div>
        <div class="box">
          <h3>Tabela de preços <small>entra sozinho em cada pedido</small></h3>
          <div class="tw" style="border:0"><table style="min-width:420px">
            <thead><tr><th>Modelo</th><th class="num">Preço</th><th>Outros nomes</th><th></th></tr></thead>
            <tbody id="pricesBody"></tbody>
          </table></div>
          <div class="toolbar" style="margin-top:12px">
            <input class="inp sm" id="newModel" placeholder="Novo modelo">
            <input class="inp sm" id="newPrice" type="number" step="0.01" placeholder="R$" style="min-width:0;width:100px">
            <button class="btn sm" id="addPrice">Adicionar</button>
          </div>
        </div>
      </div>
    </section>
  </main>
</div>
<div class="toast" id="toast"></div>

<script>
/* ============ CONFIG ============ */
const SUPABASE_URL = "https://heqtpuvxwcjutshudven.supabase.co";
const SUPABASE_ANON_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImhlcXRwdXZ4d2NqdXRzaHVkdmVuIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTA2MTI5NjcsImV4cCI6MjEwNjE4ODk2N30.eC1lJCuyYbjaz6sg6OU5A6Y6rk13O24DisflFrgwuVY";
const WA_ICON = '<svg viewBox="0 0 24 24"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.71.45 3.38 1.3 4.85L2 22l5.38-1.41a9.9 9.9 0 0 0 4.66 1.18c5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2zm5.8 14.14c-.24.68-1.4 1.3-1.93 1.35-.5.05-.97.23-3.27-.68-2.77-1.09-4.52-3.94-4.66-4.12-.13-.18-1.11-1.48-1.11-2.82 0-1.34.7-2 .95-2.28.25-.27.54-.34.72-.34h.52c.17 0 .39-.06.61.47.24.56.8 1.94.87 2.08.07.14.12.3.02.48-.09.18-.14.3-.27.46l-.41.48c-.14.14-.28.29-.12.56.16.27.71 1.17 1.52 1.9 1.05.93 1.93 1.22 2.2 1.36.27.14.43.12.59-.07.16-.18.68-.8.86-1.07.18-.27.36-.23.61-.14.25.09 1.59.75 1.86.89.27.14.45.2.52.32.07.11.07.66-.17 1.33z"/></svg>';
const STATUS = {pendente:"Pendente · WhatsApp",confirmado:"Confirmado",concluido:"Concluído",cancelado:"Cancelado",faltou:"Faltou"};
const NOT_SALE = ["cancelado","faltou"];
const PALETTE = ["#F5D867","#E3B640","#C8961E","#FFE9A8","#B8861C","#E8CF8A","#9C7A2A","#FBE27A","#D9A441","#7d6d4f"];

const sb = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
let ALL=[], PRICES=[], period="30", basis="pedido", charts={}, channel=null, justAdded=new Set();

/* ============ HELPERS ============ */
const $=id=>document.getElementById(id);
const esc=s=>String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const brl=v=>(Number(v)||0).toLocaleString("pt-BR",{style:"currency",currency:"BRL"});
const pad=n=>String(n).padStart(2,"0");
const keyOf=d=>`${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}`;
const fmtDay=k=>{if(!k)return"—";const[y,m,d]=k.split("-");return`${d}/${m}/${y}`};
const fmtDayW=k=>{if(!k)return"—";const[y,m,d]=k.split("-").map(Number);return new Date(y,m-1,d).toLocaleDateString("pt-BR",{weekday:"short",day:"2-digit",month:"2-digit"})};
const fmtDT=iso=>iso?new Date(iso).toLocaleString("pt-BR",{day:"2-digit",month:"2-digit",hour:"2-digit",minute:"2-digit"}):"—";
const digits=s=>String(s||"").replace(/\D/g,"");
const waNum=p=>{let d=digits(p);if(d.length<=11)d="55"+d;return d};
const fmtPhone=p=>{const d=digits(p).replace(/^55(?=\d{10,11}$)/,"");return d.length===11?`(${d.slice(0,2)}) ${d.slice(2,7)}-${d.slice(7)}`:d.length===10?`(${d.slice(0,2)}) ${d.slice(2,6)}-${d.slice(6)}`:p};
const time5=t=>String(t||"").slice(0,5);
const isSale=b=>!NOT_SALE.includes(b.status||"pendente");
const orderDay=b=>b.created_at?keyOf(new Date(b.created_at)):b.booking_date;
const dayOf=b=>basis==="atend"?b.booking_date:orderDay(b);
function toast(msg){const t=document.createElement("div");t.innerHTML=msg;$("toast").appendChild(t);setTimeout(()=>t.remove(),6000)}

function range(){
  const t=new Date();t.setHours(0,0,0,0);const today=keyOf(t);
  if(period==="today")return[today,today];
  if(period==="7"){const a=new Date(t);a.setDate(a.getDate()-6);return[keyOf(a),basis==="atend"?"9999-12-31":today]}
  if(period==="30"){const a=new Date(t);a.setDate(a.getDate()-29);return[keyOf(a),basis==="atend"?"9999-12-31":today]}
  if(period==="month"){const a=new Date(t.getFullYear(),t.getMonth(),1),b=new Date(t.getFullYear(),t.getMonth()+1,0);return[keyOf(a),keyOf(b)]}
  if(period==="custom")return[$("dFrom").value||"0000-01-01",$("dTo").value||"9999-12-31"];
  return["0000-01-01","9999-12-31"];
}
function inPeriod(){const[a,b]=range();return ALL.filter(x=>{const d=dayOf(x);return d&&d>=a&&d<=b})}
function modelStats(list){
  const m={};list.filter(isSale).forEach(b=>{const k=b.style||"—";m[k]=m[k]||{model:k,n:0,rev:0};m[k].n++;m[k].rev+=Number(b.price)||0});
  return Object.values(m).sort((a,b)=>b.n-a.n||b.rev-a.rev);
}

/* ============ AUTH ============ */
$("loginForm").addEventListener("submit",async e=>{
  e.preventDefault();$("loginErr").textContent="";
  const f=e.target,btn=f.querySelector("button");btn.disabled=true;btn.textContent="Entrando…";
  const{error}=await sb.auth.signInWithPassword({email:f.email.value.trim(),password:f.password.value});
  btn.disabled=false;btn.textContent="Entrar";
  if(error){$("loginErr").textContent="E-mail ou senha incorretos.";return}
  boot();
});
$("logout").onclick=async()=>{await sb.auth.signOut();location.reload()};

async function boot(){
  const{data:{session}}=await sb.auth.getSession();
  if(!session){$("login").hidden=false;$("app").hidden=true;return}
  const{data:ok,error}=await sb.rpc("is_admin");
  if(error||!ok){await sb.auth.signOut();$("login").hidden=false;$("app").hidden=true;
    $("loginErr").textContent=error?"Rode o arquivo admin-setup.sql no Supabase primeiro.":"Este usuário não tem acesso de administrador.";return}
  $("login").hidden=true;$("app").hidden=false;
  await Promise.all([loadBookings(),loadPrices()]);
  fillFilters();renderAll();subscribe();
}

/* ============ DADOS ============ */
async function loadBookings(){
  let rows=[],from=0;
  while(true){
    const{data,error}=await sb.from("bookings").select("*").order("created_at",{ascending:false}).range(from,from+999);
    if(error){toast("Erro ao carregar pedidos: "+esc(error.message));break}
    rows=rows.concat(data);if(data.length<1000)break;from+=1000;
  }
  ALL=rows.map(r=>({...r,status:r.status||"pendente"}));
}
async function loadPrices(){
  const{data,error}=await sb.from("lash_prices").select("*").order("model");
  if(!error)PRICES=data;
}
function subscribe(){
  channel=sb.channel("admin-bookings")
    .on("postgres_changes",{event:"*",schema:"public",table:"bookings"},p=>{
      if(p.eventType==="INSERT"){
        ALL.unshift({...p.new,status:p.new.status||"pendente"});justAdded.add(p.new.id);
        toast(`✨ <b>Novo pedido</b><br>${esc(p.new.name)} · ${esc(p.new.style)}<br><span class="gold-text">${p.new.price!=null?brl(p.new.price):"sem preço"}</span> · ${fmtDay(p.new.booking_date)} às ${time5(p.new.booking_time)}`);
        try{new Audio("data:audio/wav;base64,UklGRlQAAABXQVZFZm10IBAAAAABAAEAQB8AAEAfAAABAAgAZGF0YTAAAACAgICAgICAgICAgICAgICAgICAgP+AAP+AAP+AAP+AAP+AAP+AAP+AAP+AgICAgA==").play()}catch(e){}
      }else if(p.eventType==="UPDATE"){const i=ALL.findIndex(x=>x.id===p.new.id);if(i>=0)ALL[i]={...ALL[i],...p.new}}
      else if(p.eventType==="DELETE"){ALL=ALL.filter(x=>x.id!==p.old.id)}
      fillFilters();renderAll();
    })
    .subscribe(s=>$("live").classList.toggle("on",s==="SUBSCRIBED"));
}
async function updateBooking(id,patch){
  const{error}=await sb.from("bookings").update(patch).eq("id",id);
  if(error){toast("Não salvou: "+esc(error.message));return false}
  const b=ALL.find(x=>x.id===id);if(b)Object.assign(b,patch);return true;
}

/* ============ RENDER ============ */
function renderAll(){renderMissing();renderOverview();renderOrders();renderClients();renderDaily();renderModels()}

function renderMissing(){
  const miss={};ALL.filter(b=>b.price==null&&isSale(b)).forEach(b=>miss[b.style||"—"]=(miss[b.style||"—"]||0)+1);
  const k=Object.keys(miss);
  $("missingWarn").innerHTML=k.length?`<div class="warnbox"><b>Modelos sem preço na tabela:</b> ${k.map(x=>`${esc(x)} (${miss[x]})`).join(", ")}. Cadastre em <u style="cursor:pointer" onclick="go('models')">Modelos & preços</u> para somar no faturamento.</div>`:"";
}

function renderOverview(){
  const list=inPeriod(),sales=list.filter(isSale);
  const rev=sales.reduce((s,b)=>s+(Number(b.price)||0),0);
  const done=list.filter(b=>b.status==="concluido"),doneRev=done.reduce((s,b)=>s+(Number(b.price)||0),0);
  const cli=new Set(sales.map(b=>digits(b.phone))).size;
  const top=modelStats(list)[0];
  const t=keyOf(new Date());const todayRev=ALL.filter(b=>isSale(b)&&dayOf(b)===t).reduce((s,b)=>s+(Number(b.price)||0),0);
  $("kpis").innerHTML=`
    <div class="kpi hero"><small>Faturamento no período</small><b>${brl(rev)}</b><span>${sales.length} agendamento(s) vendidos</span></div>
    <div class="kpi"><small>Hoje</small><b>${brl(todayRev)}</b><span>${ALL.filter(b=>isSale(b)&&dayOf(b)===t).length} pedido(s)</span></div>
    <div class="kpi"><small>Ticket médio</small><b>${brl(sales.length?rev/sales.length:0)}</b><span>por atendimento</span></div>
    <div class="kpi"><small>Modelo campeão</small><b style="font-size:1.25rem">${top?esc(top.model):"—"}</b><span>${top?top.n+" saída(s) · "+brl(top.rev):""}</span></div>
    <div class="kpi"><small>Realizado</small><b>${brl(doneRev)}</b><span>${done.length} concluído(s)</span></div>
    <div class="kpi"><small>Clientes</small><b>${cli}</b><span>${list.filter(b=>!isSale(b)).length} cancelado(s)/falta(s)</span></div>`;
  const byDay=dailySeries(list);
  $("chartSub").textContent=basis==="atend"?"por data do atendimento":"por data do pedido";
  drawBar("chDaily",byDay);
  const ms=modelStats(list),max=ms[0]?.n||1;
  $("rankTop").innerHTML=ms.length?ms.slice(0,8).map((m,i)=>`<div class="rank-row"><span class="n">${i+1}</span><div><b style="font-weight:500">${esc(m.model)}</b> <small>· ${brl(m.rev)}</small><div class="bar"><i style="width:${m.n/max*100}%"></i></div></div><b>${m.n}</b></div>`).join(""):`<div class="empty">Sem vendas no período</div>`;
  drawDoughnut(ms);
  const now=keyOf(new Date());
  const up=ALL.filter(b=>b.booking_date>=now&&isSale(b)).sort((a,b)=>(a.booking_date+time5(a.booking_time)).localeCompare(b.booking_date+time5(b.booking_time))).slice(0,8);
  $("upcoming").innerHTML=up.length?up.map(b=>`<div><span><b style="font-weight:500">${esc(b.name)}</b><br><small style="color:var(--dim)">${esc(b.style)}</small></span><em>${fmtDayW(b.booking_date)} · ${time5(b.booking_time)}</em></div>`).join(""):`<div class="empty">Nenhum atendimento futuro</div>`;
}
function dailySeries(list){
  const[a,b]=range(),map={};
  list.filter(isSale).forEach(x=>{const d=dayOf(x);map[d]=map[d]||{n:0,rev:0};map[d].n++;map[d].rev+=Number(x.price)||0});
  let keys=Object.keys(map).sort();
  if(a!=="0000-01-01"&&keys.length){ /* completa os dias vazios */
    const start=new Date(a+"T00:00"),endK=b==="9999-12-31"?keys[keys.length-1]:b,end=new Date(endK+"T00:00");
    if((end-start)/864e5<=120){keys=[];for(let d=new Date(start);d<=end;d.setDate(d.getDate()+1))keys.push(keyOf(d))}
  }
  return{labels:keys.map(k=>fmtDay(k).slice(0,5)),rev:keys.map(k=>map[k]?.rev||0),n:keys.map(k=>map[k]?.n||0),keys,map};
}
Chart.defaults.color="#B8A57E";Chart.defaults.font.family="Poppins";Chart.defaults.borderColor="rgba(58,46,27,.6)";
function drawBar(id,s){
  charts[id]?.destroy();
  const ctx=$(id).getContext("2d"),g=ctx.createLinearGradient(0,0,0,280);g.addColorStop(0,"#F5D867");g.addColorStop(1,"rgba(200,150,30,.35)");
  charts[id]=new Chart(ctx,{data:{labels:s.labels,datasets:[
    {type:"bar",label:"Faturamento",data:s.rev,backgroundColor:g,borderRadius:6,yAxisID:"y",order:2},
    {type:"line",label:"Pedidos",data:s.n,borderColor:"#F6EDD6",backgroundColor:"#F6EDD6",pointRadius:2,cubicInterpolationMode:"monotone",yAxisID:"y1",order:1}]},
    options:{responsive:true,maintainAspectRatio:false,interaction:{mode:"index",intersect:false},
      plugins:{legend:{labels:{boxWidth:10}},tooltip:{callbacks:{label:c=>c.dataset.label==="Faturamento"?" "+brl(c.raw):" "+c.raw+" pedido(s)"}}},
      scales:{y:{beginAtZero:true,ticks:{callback:v=>"R$ "+v}},y1:{beginAtZero:true,position:"right",grid:{display:false},ticks:{precision:0}},x:{grid:{display:false}}}}});
}
function drawDoughnut(ms){
  charts.m?.destroy();
  charts.m=new Chart($("chModels"),{type:"doughnut",data:{labels:ms.map(m=>m.model),datasets:[{data:ms.map(m=>m.rev),backgroundColor:PALETTE,borderColor:"#1f1810",borderWidth:3}]},
    options:{responsive:true,maintainAspectRatio:false,cutout:"62%",plugins:{legend:{position:"right",labels:{boxWidth:10}},tooltip:{callbacks:{label:c=>" "+c.label+": "+brl(c.raw)}}}}});
}

function fillFilters(){
  const fs=$("fStatus"),fm=$("fModel"),vs=fs.value,vm=fm.value;
  fs.innerHTML=`<option value="">Todos os status</option>`+Object.entries(STATUS).map(([k,v])=>`<option value="${k}">${v}</option>`).join("");
  const models=[...new Set(ALL.map(b=>b.style).filter(Boolean))].sort();
  fm.innerHTML=`<option value="">Todos os modelos</option>`+models.map(m=>`<option>${esc(m)}</option>`).join("");
  fs.value=vs;fm.value=vm;
}
function renderOrders(){
  const q=$("q").value.toLowerCase().trim(),qd=digits(q),fs=$("fStatus").value,fm=$("fModel").value;
  const list=inPeriod().filter(b=>(!fs||b.status===fs)&&(!fm||b.style===fm)&&(!q||String(b.name).toLowerCase().includes(q)||(qd&&digits(b.phone).includes(qd))));
  $("cOrders").textContent=list.length;
  if(!list.length){$("ordersBody").innerHTML=`<tr><td colspan="9" class="empty">Nenhum pedido no período</td></tr>`;return}
  $("ordersBody").innerHTML=list.map(b=>{
    const msg=encodeURIComponent(`Olá, ${String(b.name).split(" ")[0]}! Aqui é da Larissa Amorim Lash Academy 💛 Seu horário de ${b.style} está marcado para ${fmtDay(b.booking_date)} às ${time5(b.booking_time)}.`);
    return`<tr data-id="${esc(b.id)}" class="${justAdded.has(b.id)?"new":""}">
      <td style="white-space:nowrap">${fmtDT(b.created_at)}</td>
      <td style="white-space:nowrap"><b style="font-weight:500">${fmtDayW(b.booking_date)}</b><br><small style="color:var(--dim)">${time5(b.booking_time)}</small></td>
      <td class="cli"><b>${esc(b.name)}</b></td>
      <td><a class="wa" target="_blank" rel="noopener" href="https://wa.me/${waNum(b.phone)}?text=${msg}">${WA_ICON}${esc(fmtPhone(b.phone))}</a></td>
      <td><span class="pill">${esc(b.style)}</span></td>
      <td class="num"><input class="price-in ${b.price==null?"missing":""}" type="number" step="0.01" value="${b.price??""}" placeholder="—" data-f="price"></td>
      <td><select class="st" data-s="${b.status}" data-f="status">${Object.entries(STATUS).map(([k,v])=>`<option value="${k}" ${k===b.status?"selected":""}>${v}</option>`).join("")}</select></td>
      <td><input class="note-in" value="${esc(b.notes||"")}" placeholder="Anotar…" data-f="notes"></td>
      <td><button class="btn danger sm" data-del title="Excluir e liberar o horário">✕</button></td></tr>`}).join("");
  justAdded.clear();
}
$("ordersBody").addEventListener("change",async e=>{
  const el=e.target,tr=el.closest("tr"),id=tr?.dataset.id,f=el.dataset.f;if(!id||!f)return;
  let val=el.value;if(f==="price")val=val===""?null:Number(val);
  if(await updateBooking(id,{[f]:val})){if(f==="status")el.dataset.s=val;if(f==="price")el.classList.toggle("missing",val==null);renderOverview();renderClients();renderDaily();renderModels();renderMissing()}
});
$("ordersBody").addEventListener("click",async e=>{
  if(!e.target.closest("[data-del]"))return;
  const id=e.target.closest("tr").dataset.id,b=ALL.find(x=>x.id===id);
  if(!confirm(`Excluir o pedido de ${b.name} (${fmtDay(b.booking_date)} ${time5(b.booking_time)})?\nO horário volta a ficar livre no site.`))return;
  const{error}=await sb.from("bookings").delete().eq("id",id);
  if(error)return toast("Não excluiu: "+esc(error.message));
  ALL=ALL.filter(x=>x.id!==id);renderAll();
});
["q","fStatus","fModel"].forEach(i=>$(i).addEventListener("input",renderOrders));

function renderClients(){
  const q=$("qc").value.toLowerCase().trim(),m={};
  ALL.forEach(b=>{const k=digits(b.phone)||b.name;const c=m[k]=m[k]||{name:b.name,phone:b.phone,n:0,rev:0,models:{},last:"",first:b.created_at};
    if(isSale(b)){c.n++;c.rev+=Number(b.price)||0;c.models[b.style]=(c.models[b.style]||0)+1}
    if((b.booking_date||"")>c.last){c.last=b.booking_date;c.name=b.name}
    if(b.created_at&&(!c.first||b.created_at<c.first))c.first=b.created_at});
  let list=Object.values(m).filter(c=>!q||c.name.toLowerCase().includes(q)||digits(c.phone).includes(digits(q)||"#")).sort((a,b)=>b.rev-a.rev||b.n-a.n);
  $("cClients").textContent=Object.keys(m).length;
  $("clientsBody").innerHTML=list.length?list.map(c=>{const fav=Object.entries(c.models).sort((a,b)=>b[1]-a[1])[0];
    return`<tr><td class="cli"><b>${esc(c.name)}</b>${c.n>1?`<small>cliente recorrente</small>`:""}</td>
      <td><a class="wa" target="_blank" rel="noopener" href="https://wa.me/${waNum(c.phone)}">${WA_ICON}${esc(fmtPhone(c.phone))}</a></td>
      <td class="num">${c.n}</td><td class="num money">${brl(c.rev)}</td><td>${fav?esc(fav[0]):"—"}</td><td>${fmtDay(c.last)}</td><td>${fmtDT(c.first)}</td></tr>`}).join(""):`<tr><td colspan="7" class="empty">Nenhum cliente</td></tr>`;
}
$("qc").addEventListener("input",renderClients);

function renderDaily(){
  const list=inPeriod(),s=dailySeries(list),models=modelStats(list).map(m=>m.model);
  $("dailySub").textContent=basis==="atend"?"por data do atendimento":"por data do pedido";
  drawBar("chDaily2",s);
  $("dailyHead").innerHTML=`<tr><th>Dia</th><th class="num">Pedidos</th>${models.map(m=>`<th class="num">${esc(m)}</th>`).join("")}<th class="num">Faturamento</th></tr>`;
  const per={};list.filter(isSale).forEach(b=>{const d=dayOf(b);per[d]=per[d]||{};per[d][b.style]=(per[d][b.style]||0)+1});
  const days=s.keys.filter(k=>s.map[k]).reverse();
  let tn=0,tr=0;const tm={};
  const rows=days.map(k=>{const d=s.map[k];tn+=d.n;tr+=d.rev;models.forEach(m=>tm[m]=(tm[m]||0)+(per[k][m]||0));
    return`<tr><td style="white-space:nowrap"><b style="font-weight:500">${fmtDayW(k)}</b></td><td class="num">${d.n}</td>${models.map(m=>`<td class="num">${per[k][m]||"<span style='color:#4a3d27'>·</span>"}</td>`).join("")}<td class="num money"><b style="font-weight:500">${brl(d.rev)}</b></td></tr>`}).join("");
  $("dailyBody").innerHTML=rows?rows+`<tr class="tfoot"><td>Total</td><td class="num">${tn}</td>${models.map(m=>`<td class="num">${tm[m]}</td>`).join("")}<td class="num money gold-text">${brl(tr)}</td></tr>`:`<tr><td colspan="3" class="empty">Sem vendas no período</td></tr>`;
}

function renderModels(){
  const ms=modelStats(inPeriod()),tot=ms.reduce((s,m)=>s+m.n,0)||1;
  $("modelsBody").innerHTML=ms.length?ms.map((m,i)=>`<tr><td class="n" style="color:var(--gold2);font-family:'Playfair Display'">${i+1}</td><td>${esc(m.model)}</td><td class="num">${m.n}</td><td class="num">${(m.n/tot*100).toFixed(0)}%</td><td class="num money">${brl(m.rev)}</td><td class="num money">${brl(m.rev/m.n)}</td></tr>`).join(""):`<tr><td colspan="6" class="empty">Sem vendas no período</td></tr>`;
  $("pricesBody").innerHTML=PRICES.map(p=>`<tr data-m="${esc(p.model)}"><td><b style="font-weight:500">${esc(p.model)}</b></td>
    <td class="num"><input class="price-in" type="number" step="0.01" value="${p.price}" data-pf="price"></td>
    <td><input class="note-in" value="${esc((p.aliases||[]).join(", "))}" placeholder="ex.: fox eyes" data-pf="aliases" title="Nomes alternativos separados por vírgula"></td>
    <td><button class="btn danger sm" data-pdel>✕</button></td></tr>`).join("");
}
$("pricesBody").addEventListener("change",async e=>{
  const el=e.target,f=el.dataset.pf,model=el.closest("tr")?.dataset.m;if(!f)return;
  const val=f==="price"?Number(el.value):el.value.split(",").map(s=>s.trim()).filter(Boolean);
  const{error}=await sb.from("lash_prices").update({[f]:val,updated_at:new Date().toISOString()}).eq("model",model);
  if(error)return toast("Não salvou: "+esc(error.message));
  await loadPrices();await applyMissing();toast("Tabela de preços atualizada ✓");
});
$("pricesBody").addEventListener("click",async e=>{
  if(!e.target.closest("[data-pdel]"))return;const model=e.target.closest("tr").dataset.m;
  if(!confirm(`Remover ${model} da tabela? Pedidos já feitos mantêm o valor.`))return;
  await sb.from("lash_prices").delete().eq("model",model);await loadPrices();renderModels();
});
$("addPrice").onclick=async()=>{
  const model=$("newModel").value.trim(),price=Number($("newPrice").value);if(!model||!price)return toast("Informe modelo e preço.");
  const{error}=await sb.from("lash_prices").upsert({model,price});
  if(error)return toast("Não salvou: "+esc(error.message));
  $("newModel").value="";$("newPrice").value="";await loadPrices();await applyMissing();toast(`${esc(model)} adicionado ✓`);
};
/* aplica preço aos pedidos que ficaram sem valor */
async function applyMissing(){
  const norm=s=>String(s||"").toLowerCase().trim();
  const find=st=>PRICES.find(p=>norm(p.model)===norm(st)||(p.aliases||[]).some(a=>norm(a)===norm(st)));
  const todo=ALL.filter(b=>b.price==null&&find(b.style));
  for(const b of todo)await updateBooking(b.id,{price:Number(find(b.style).price)});
  renderAll();
}

/* ============ UI ============ */
function go(t){document.querySelectorAll("#tabs button").forEach(b=>b.classList.toggle("on",b.dataset.t===t));
  document.querySelectorAll(".panel").forEach(p=>p.classList.toggle("on",p.id==="p-"+t))}
window.go=go;
$("tabs").addEventListener("click",e=>{const b=e.target.closest("button");if(b)go(b.dataset.t)});
$("period").addEventListener("click",e=>{const b=e.target.closest("button");if(!b)return;period=b.dataset.p;
  document.querySelectorAll("#period button").forEach(x=>x.classList.toggle("on",x===b));$("customRange").hidden=period!=="custom";renderAll()});
["dFrom","dTo"].forEach(i=>$(i).addEventListener("change",renderAll));
$("basis").addEventListener("change",e=>{basis=e.target.value;renderAll()});
$("exportBtn").onclick=()=>{
  const rows=[["Pedido em","Data atendimento","Horário","Cliente","Telefone","Modelo","Valor","Status","Anotações"]]
    .concat(inPeriod().map(b=>[b.created_at?new Date(b.created_at).toLocaleString("pt-BR"):"",fmtDay(b.booking_date),time5(b.booking_time),b.name,b.phone,b.style,String(b.price??"").replace(".",","),STATUS[b.status]||b.status,b.notes||""]));
  const csv="\ufeff"+rows.map(r=>r.map(v=>`"${String(v??"").replace(/"/g,'""')}"`).join(";")).join("\n");
  const a=document.createElement("a");a.href=URL.createObjectURL(new Blob([csv],{type:"text/csv"}));a.download=`vendas-larissa-amorim-${keyOf(new Date())}.csv`;a.click();
};
sb.auth.onAuthStateChange(ev=>{if(ev==="SIGNED_OUT"){$("app").hidden=true;$("login").hidden=false;channel&&sb.removeChannel(channel)}});
boot();
</script>
